# Production environment variables for WritingTracker
# Copy to server/.env.production and fill in values before deploying

# Generate bcrypt hash with:
#   node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(h=>console.log(h))"
# or:
#   htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
ADMIN_PASSWORD_HASH=

PORT=3001
NODE_ENV=production
DB_PATH=/app/data/writing_tracker.db
